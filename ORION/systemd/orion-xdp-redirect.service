[Unit]
Description=ORION XDP - Modo Rendimiento (NAT + REDIRECT, sin MITM ni Packetbeat - ver flow_consumer)
After=elasticsearch.service network-online.target
Wants=elasticsearch.service network-online.target

# Solo uno de los dos modos puede estar activo a la vez.
# Si arrancas este, systemd para automaticamente orion-xdp-pass.
Conflicts=orion-xdp-pass.service

# Cuando arranca este, sigue automaticamente al consumer del ring buffer
# para no perder visibilidad del trafico redirigido.
Wants=orion-flow-consumer.service
Before=orion-flow-consumer.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/minerva/Escritorio/TFG_Fabian/ORION
ExecStart=/usr/bin/python3 /home/minerva/Escritorio/TFG_Fabian/ORION/tools/xdp_nat_redirect.py
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orion-xdp-redirect

[Install]
WantedBy=multi-user.target
